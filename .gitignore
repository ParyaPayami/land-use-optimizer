# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example

# Data, checkpoints and run outputs (large; archive on Zenodo instead)
data/
*.pt
*.pth
results/*
!results/.gitkeep
# The paper's run: small summaries and logs are versioned; checkpoints and plans are not.
!results/paper/
results/paper/*
!results/paper/*.json
!results/paper/metrics.csv
!results/paper/logs/
!results/paper/logs/**
# Generated paper assets are versioned so the manuscript compiles with the reported results.

# LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.spl
paper/*.synctex.gz
paper/FINAL_SUBMISSION.pdf
